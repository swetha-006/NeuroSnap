# Keep threshold.json (small, needed for deployment)
!saved_model/threshold.json

# Flask uploads (user uploaded images - not needed in repo)
static/uploads/*
!static/uploads/.gitkeep

# Jupyter checkpoints
.ipynb_checkpoints/

